# Copy this file to ".env" and fill it in. NEVER commit ".env" or share it.
# Safaricom Daraja (developer.safaricom.co.ke > My Apps > your app)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# From APIs > M-Pesa Express > Simulate (sandbox test values)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Your public ngrok address, no trailing slash, e.g. https://abcd-12-34.ngrok-free.app
PUBLIC_URL=
# Any long random text. It becomes part of the callback address so only Safaricom (who is told it) can call it.
CALLBACK_SECRET=
# Firebase project ID (Firebase console > Project settings > General > Project ID)
FIREBASE_PROJECT_ID=
